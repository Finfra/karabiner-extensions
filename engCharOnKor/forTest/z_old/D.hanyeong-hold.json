{
  "title": "[TEST-D] EngCharOnKor — 한/영 키 홀드 레이어 (짧게 누르면 평소대로 전환)",
  "rules": [
    {
      "description": "[TEST-D] 한/영(keypad_comma) 을 누르고 있는 동안 a/l → 영문 · 짧게 누르면 한/영 전환",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "keypad_comma",
            "modifiers": {
              "optional": [
                "any"
              ]
            }
          },
          "to_if_alone": [
            {
              "key_code": "keypad_comma"
            }
          ],
          "to_if_held_down": [
            {
              "set_variable": {
                "name": "keyboardLayoutSettingIsEng",
                "value": 1
              }
            }
          ],
          "to_after_key_up": [
            {
              "set_variable": {
                "name": "keyboardLayoutSettingIsEng",
                "value": 0
              }
            }
          ],
          "parameters": {
            "basic.to_if_alone_timeout_milliseconds": 300,
            "basic.to_if_held_down_threshold_milliseconds": 120
          }
        },
        {
          "type": "basic",
          "conditions": [
            {
              "type": "variable_if",
              "name": "keyboardLayoutSettingIsEng",
              "value": 1
            },
            {
              "type": "input_source_if",
              "input_sources": [
                {
                  "language": "^ko$"
                }
              ]
            }
          ],
          "from": {
            "key_code": "a",
            "modifiers": {
              "optional": [
                "any"
              ]
            }
          },
          "to": [
            {
              "select_input_source": {
                "language": "^en$"
              }
            },
            {
              "key_code": "a"
            }
          ],
          "to_after_key_up": [
            {
              "select_input_source": {
                "language": "^ko$"
              }
            }
          ]
        },
        {
          "type": "basic",
          "conditions": [
            {
              "type": "variable_if",
              "name": "keyboardLayoutSettingIsEng",
              "value": 1
            },
            {
              "type": "input_source_if",
              "input_sources": [
                {
                  "language": "^ko$"
                }
              ]
            }
          ],
          "from": {
            "key_code": "l",
            "modifiers": {
              "optional": [
                "any"
              ]
            }
          },
          "to": [
            {
              "select_input_source": {
                "language": "^en$"
              }
            },
            {
              "key_code": "l"
            }
          ],
          "to_after_key_up": [
            {
              "select_input_source": {
                "language": "^ko$"
              }
            }
          ]
        }
      ]
    }
  ]
}
