{
  "title": "[TEST-A] EngCharOnKor — 오른쪽 커맨드 + 글자 (키당 왕복)",
  "rules": [
    {
      "description": "[TEST-A] 한글 모드에서 ⌘(오른쪽) + a/l → 영문 a/l · 키를 떼면 한글 복귀",
      "manipulators": [
        {
          "type": "basic",
          "conditions": [
            {
              "type": "input_source_if",
              "input_sources": [
                {
                  "language": "^ko$"
                }
              ]
            }
          ],
          "from": {
            "key_code": "a",
            "modifiers": {
              "mandatory": [
                "right_command"
              ]
            }
          },
          "to": [
            {
              "select_input_source": {
                "language": "^en$"
              }
            },
            {
              "key_code": "a"
            }
          ],
          "to_after_key_up": [
            {
              "select_input_source": {
                "language": "^ko$"
              }
            }
          ]
        },
        {
          "type": "basic",
          "conditions": [
            {
              "type": "input_source_if",
              "input_sources": [
                {
                  "language": "^ko$"
                }
              ]
            }
          ],
          "from": {
            "key_code": "l",
            "modifiers": {
              "mandatory": [
                "right_command"
              ]
            }
          },
          "to": [
            {
              "select_input_source": {
                "language": "^en$"
              }
            },
            {
              "key_code": "l"
            }
          ],
          "to_after_key_up": [
            {
              "select_input_source": {
                "language": "^ko$"
              }
            }
          ]
        }
      ]
    }
  ]
}
