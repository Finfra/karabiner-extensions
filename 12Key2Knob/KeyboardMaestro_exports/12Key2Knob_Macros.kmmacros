						<key>MacroActionType</key>
						<string>IfThenElse</string>
						<key>ThenActions</key>
						<array>
							<dict>
								<key>ActionUID</key>
								<integer>149403</integer>
								<key>DisplayKind</key>
								<string>None</string>
								<key>HonourFailureSettings</key>
								<true/>
								<key>IncludeStdErr</key>
								<false/>
								<key>IncludedVariables</key>
								<array>
									<string>9999</string>
								</array>
								<key>MacroActionType</key>
								<string>ExecuteAppleScript</string>
								<key>Path</key>
								<string></string>
								<key>Text</key>
								<string>tell application "Keynote"	-- 현재 활성화된 프레젠테이션을 가져옴	set currentDocument to front document	tell currentDocument		-- 현재 선택된 객체들을 가져옴		set selectedItems to get selection		-- 선택된 객체가 있으면 실행		if (count of selectedItems) &gt; 0 then			set selectedShape to item 1 of selectedItems			-- 현재 크기를 가져옴			set currentWidth to width of selectedShape			set currentHeight to height of selectedShape						-- 크기를 10% 증가시킴			set newWidth to currentWidth / 1.1									-- 새로운 크기로 설정			set width of selectedShape to newWidth			set height of selectedShape to newHeight		else			display alert "No object selected" message "Please select an object to resize."		end if	end tellend tell</string>
								<key>TimeOutAbortsMacro</key>
								<true/>
								<key>TrimResults</key>
								<true/>
								<key>TrimResultsNew</key>
								<true/>
								<key>UseText</key>
								<true/>
							</dict>
						</array>
						<key>TimeOutAbortsMacro</key>
						<true/>
					</dict>
				</array>
